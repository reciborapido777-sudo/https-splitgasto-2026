# ─────────────────────────────────────────────────────────────────
# SplitGasto 2026 - Cloudflare Pages Headers (v4.4 Gold)
# Protocolo: Inmutabilidad de Motor y Frescura de Rutas Limpias
# ─────────────────────────────────────────────────────────────────

# ── 1. Seguridad Universal (Todos los paths) ─────────────────────
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# ── 2. Rutas Limpias & HTML (Sincronización con Router v4.4) ─────
# Forzamos frescura total en las rutas virtuales para evitar BFcache bugs
/dashboard
  Cache-Control: no-cache, no-store, must-revalidate
/groups
  Cache-Control: no-cache, no-store, must-revalidate
/activity
  Cache-Control: no-cache, no-store, must-revalidate
/vault
  Cache-Control: no-cache, no-store, must-revalidate
/analytics
  Cache-Control: no-cache, no-store, must-revalidate
/profile
  Cache-Control: no-cache, no-store, must-revalidate
/add-expense
  Cache-Control: no-cache, no-store, must-revalidate
/split
  Cache-Control: no-cache, no-store, must-revalidate
/notifications
  Cache-Control: no-cache, no-store, must-revalidate

# Comodín para archivos físicos .html
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# ── 3. Motor Operativo (Service Worker & Engine) ─────────────────
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/engine/*
  Cache-Control: no-cache, must-revalidate

# ── 4. Activos de Identidad (Caché Media) ────────────────────────
/manifest.json
  Cache-Control: public, max-age=86400, must-revalidate
/favicon.svg
  Cache-Control: public, max-age=86400, must-revalidate

# ── 5. Librerías e Iconografía (Inmutables) ──────────────────────
/icons/*
  Cache-Control: public, max-age=31536000, immutable
