# SplitGasto 2026 - Cloudflare Pages Headers
# Engineering Revision v4.3 — Zero-cache HTML, correct asset TTLs, camera=(self) for scanner

# ── Security headers for ALL paths ──────────────────────────────────────────
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self)
  X-XSS-Protection: 1; mode=block

# ── HTML pages — NEVER cache; always validate with server ───────────────────
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# ── Service Worker — NEVER cache ─────────────────────────────────────────
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# ── Manifest — short cache (1 day) ──────────────────────────────────────────
/manifest.json
  Cache-Control: public, max-age=86400, must-revalidate

# ── Engine assets (CSS/JS) — short cache, always revalidate ─────────────────
/engine/*
  Cache-Control: no-cache, must-revalidate

# ── Favicon files — 1 day cache ──────────────────────────────────────────
/favicon.svg
  Cache-Control: public, max-age=86400, must-revalidate

/favicon-32.png
  Cache-Control: public, max-age=86400, must-revalidate

/favicon-16.png
  Cache-Control: public, max-age=86400, must-revalidate

/apple-touch-icon.png
  Cache-Control: public, max-age=86400, must-revalidate

# ── Static icons (immutable, content-hashed names) ──────────────────────────
/icons/*
  Cache-Control: public, max-age=31536000, immutable
